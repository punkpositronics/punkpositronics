---
import Layout from '../layouts/BlogPost.astro';

type Tool = { name: string; replaces: string; note: string };
type Section = { title: string; tools: Tool[] };

const quickWins: Section[] = [
	{
		title: 'The On-Ramp',
		tools: [
			{ name: 'CasaOS / YunoHost', replaces: 'Cloud App Stores', note: 'The "one-click" entry point for non-technical clients; lowers the friction of the first install.' },
			{ name: 'Linux Mint', replaces: 'Windows 10/11 — license, telemetry, and the "slow laptop" that isn\'t', note: 'The Linux Revival: your own laptop, guided back to life. Free forever, no forced-update reboots, no spyware. LibreOffice preinstalled.' },
			{ name: 'LibreOffice', replaces: 'Microsoft 365 (local)', note: 'The free local document baseline — ships with every Linux install.' },
		],
	},
	{
		title: 'Passwords & Security',
		tools: [
			{ name: 'Vaultwarden', replaces: 'LastPass, 1Password, Bitwarden SaaS', note: 'The catalog\'s best first lesson. Enterprise-grade passwords without the monthly fee.' },
			{ name: 'Pi-hole / AdGuard Home', replaces: 'ISP DNS, ad-block subscriptions', note: 'Network-wide ad blocking. The classic first install.' },
			{ name: 'LocalSend', replaces: 'AirDrop, WeTransfer', note: 'Zero-config LAN file sharing, friendly to non-technical folks.' },
			{ name: 'Stirling PDF', replaces: 'Adobe Acrobat, SmallPDF', note: 'Every office\'s first "wow."' },
		],
	},
	{
		title: 'Reading, News & Notes',
		tools: [
			{ name: 'FreshRSS', replaces: 'Feedly', note: 'Own your reading list — the first step to keeping your news out of an algorithm\'s hands.' },
			{ name: 'Wallabag', replaces: 'Pocket, Instapaper', note: 'Sovereign archive of web articles; avoids the "link graveyard."' },
			{ name: 'Linkding', replaces: 'Browser Bookmarks', note: 'Lightweight, searchable, and device-independent.' },
			{ name: 'Zettlr', replaces: 'Notion (personal), Obsidian, Word for drafting', note: 'The student & writer layer: Zotero citations, linked notes, Pandoc export to .docx/.pdf — "your professor wants Word files" answered in FOSS. Desktop app, no server, $0. Preinstalled on every Linux Revival.' },
		],
	},
	{
		title: 'Shared Lists & Checklists',
		tools: [
			{ name: 'Vikunja', replaces: 'Todoist, AnyList, shared shopping/task lists (the fridge whiteboard)', note: 'The household checklist win: projects → lists → tasks → nested subtasks, per-project user and link shares (edit rights, no account needed), PWA on phones plus CalDAV sync into Apple Reminders. Single Go container + SQLite, ~30MB RAM — runs on anything.' },
		],
	},
];

const homestead: Section[] = [
	{
		title: 'Workspace & Collaboration',
		tools: [
			{ name: 'Nextcloud', replaces: 'Google Workspace, Microsoft 365, Dropbox', note: 'The sovereign workspace bedrock: files, calendar, collaboration.' },
			{ name: 'Collabora Online / OnlyOffice', replaces: 'Microsoft 365 (browser)', note: 'Real .docx/.xlsx/.pptx editing in the browser, on your own server. The piece a Cloud Exit Audit cannot dodge.' },
			{ name: 'Syncthing', replaces: 'Dropbox, OneDrive sync', note: 'Peer-to-peer file sync, no cloud middleman.' },
			{ name: 'BookStack', replaces: 'Notion, Confluence, SharePoint', note: 'The "Company Brain." WYSIWYG editor, a hierarchy anyone can grasp, MIT-licensed. Succession Protocol approved.' },
			{ name: 'Paperless-ngx', replaces: 'Filing cabinets, DMS', note: 'The canonical "sovereignty win."' },
		],
	},
	{
		title: 'Media & Libraries',
		tools: [
			{ name: 'Jellyfin', replaces: 'Netflix, Plex', note: 'The flagship Family Media Server. Your movies, music, and shows on hardware you own.' },
			{ name: 'Immich', replaces: 'Google Photos, iCloud Photos', note: 'The "Google Photos exit" — the most-recommended media tool of 2025.' },
			{ name: 'Kavita', replaces: 'Kindle/Comixology lock-in', note: 'E-books, manga, comics — the reading hub for the sovereign household.' },
			{ name: 'Audiobookshelf', replaces: 'Audible', note: 'Audiobooks & podcasts you own, served from hardware you own.' },
			{ name: 'Navidrome', replaces: 'Spotify (for owned music)', note: 'Every Subsonic client works with it.' },
			{ name: 'Mealie', replaces: 'Paprika, recipe apps', note: 'Recipes and meal planning — the family\'s gateway drug to self-hosting.' },
		],
	},
	{
		title: 'Business, Money & Storefronts',
		tools: [
			{ name: 'Metabase', replaces: 'Power BI, Tableau', note: 'The Sovereignty Analytics delivery vehicle. Dashboards and scheduled reports, zero license fees.' },
			{ name: 'Grafana', replaces: 'Datadog, Power BI dashboards', note: 'Real-time operational dashboards for the whole estate. Essential for Sovereign Continuity reporting.' },
			{ name: 'Medusa', replaces: 'Shopify, the KDP platform tax', note: 'The Digital Fortress storefront engine. Your store, your data, no platform tax.' },
			{ name: 'listmonk', replaces: 'Mailchimp', note: 'Self-hosted newsletters — your mailing list, on your server, no per-subscriber fee or platform skimming your readers.' },
			{ name: 'InvenTree', replaces: 'Fishbowl, spreadsheet sprawl', note: 'Heavy-duty inventory — for workshops, makers, and stock-heavy small businesses.' },
			{ name: 'Grocy', replaces: 'Household ERP apps', note: 'ERP for the home. Overkill for plain shared lists — that\'s Vikunja\'s job (Easy wins); Grocy earns its keep when you want full household ops (stock, chores, pantries).' },
			{ name: 'InvoiceShelf / Invoice Ninja', replaces: 'QuickBooks Invoicing, FreshBooks', note: 'Professional invoicing, quotes, and payment tracking.' },
			{ name: 'Firefly III', replaces: 'Mint, QuickBooks (personal)', note: 'Personal and small-business finance manager.' },
			{ name: 'Actual Budget', replaces: 'YNAB', note: 'The personal-finance community favorite.' },
			{ name: 'BTCPay Server', replaces: 'Stripe, PayPal', note: 'Payment processing with no processor skim — the catalog\'s purest disintermediation play.' },
			{ name: 'EspoCRM / Twenty', replaces: 'Salesforce, HubSpot', note: 'Open-source CRM for leads and clients.' },
			{ name: 'Monica', replaces: 'Cloze, contact apps', note: 'Personal CRM for deep community relationships.' },
			{ name: 'Cal.com', replaces: 'Calendly', note: 'Scheduling without the middleman.' },
			{ name: 'Ghost', replaces: 'Substack, Medium', note: 'The "sovereign Substack" candidate for publishing.' },
		],
	},
];

const expert: Section[] = [
	{
		title: 'Heavy Infrastructure',
		tools: [
			{ name: 'Proxmox VE', replaces: 'VMware, Hyper-V', note: 'The homelab standard — the homestead stack\'s spine.' },
			{ name: 'Home Assistant', replaces: 'SmartThings, vendor cloud hubs', note: 'The single most-loved self-hosted project on earth.' },
			{ name: 'Mattermost / Zulip', replaces: 'Slack, Microsoft Teams', note: 'Self-hosted team communication.' },
			{ name: 'Jitsi Meet', replaces: 'Zoom, Google Meet', note: 'Private, encrypted video conferencing.' },
			{ name: 'LibreChat / Open WebUI', replaces: 'ChatGPT, Claude SaaS', note: 'Sovereign AI gateways. Interface with LLMs privately; can be wired to your own documentation for a "queryable business manual."' },
			{ name: 'n8n', replaces: 'Zapier, Make', note: 'The workflow automation engine of every serious stack.' },
			{ name: 'Ansible / OpenTofu', replaces: 'Manual Config / Terraform', note: 'The Guardian\'s toolset; allows for rapid disaster recovery and fleet management.' },
			{ name: 'Woodpecker CI', replaces: 'GitHub Actions, GitLab CI', note: 'Sovereign build pipelines for the client\'s own custom apps.' },
			{ name: 'Authentik / Authelia', replaces: 'Okta, Azure AD', note: 'Centralized identity (SSO) for the whole estate.' },
			{ name: 'Dead Man\'s Switch', replaces: 'Hope and prayer', note: 'The ultimate continuity tool. Ensures encrypted keys and the Living Manual are released to a successor if the key-holder is unavailable.' },
			{ name: 'Mailcow / Stalwart', replaces: 'Google Workspace mail', note: 'Self-hosted email — expert tier only. The community\'s clearest red line: 86% don\'t.' },
		],
	},
];

---

<Layout
	title="The Free-Tools Catalog"
	description="A menu of free, open-source software that replaces paid subscriptions — sorted from try-it-this-afternoon to full business setups."
	pubDate={new Date()}
	heroImage="/og-default.png"
>
	<h1>The Free-Tools Catalog</h1>
	<p>
		Free and open-source software — <em>FOSS</em> — does what the paid subscriptions do, without the monthly bill and without a company peeking at your data. This is the same menu I hand to every business-audit client, sorted from "try it this afternoon" to "run your whole operation on it." (Its long name is the <em>FOSS Sovereignty Catalog</em> — all that means is: tools you own.)
	</p>

	<h2>How to read the colors</h2>
	<ul>
		<li><strong>🟢 Easy wins</strong> — runs on a laptop, a flash drive, or an old phone. Try one this afternoon.</li>
		<li><strong>🟡 Your own setup</strong> — lives on a small home server. The full replacement for paid subscriptions.</li>
		<li><strong>🔴 Advanced</strong> — heavy or high-stakes. This is where ongoing-care clients live.</li>
	</ul>

	<h2>🟢 Easy wins</h2>
	{quickWins.map((section) => (
		<Fragment>
			<h3>{section.title}</h3>
			<ul class="tools">
				{section.tools.map((t) => (
					<li>
						<strong>{t.name}</strong>
						<span class="replaces">replaces {t.replaces}</span>
						<p>{t.note}</p>
					</li>
				))}
			</ul>
		</Fragment>
	))}

	<h2>🟡 Your own setup</h2>
	<p>This tier is what a business audit delivers: a complete replacement for the tools you rent today.</p>
	{homestead.map((section) => (
		<Fragment>
			<h3>{section.title}</h3>
			<ul class="tools">
				{section.tools.map((t) => (
					<li>
						<strong>{t.name}</strong>
						<span class="replaces">replaces {t.replaces}</span>
						<p>{t.note}</p>
					</li>
				))}
			</ul>
		</Fragment>
	))}

	<h2>🔴 Advanced</h2>
	{expert.map((section) => (
		<Fragment>
			<h3>{section.title}</h3>
			<ul class="tools">
				{section.tools.map((t) => (
					<li>
						<strong>{t.name}</strong>
						<span class="replaces">replaces {t.replaces}</span>
						<p>{t.note}</p>
					</li>
				))}
			</ul>
		</Fragment>
	))}

	<h2>The Honest Ledger</h2>
	<ul>
		<li><strong>Some tools are "source-available"</strong> (Metabase, Cal.com, n8n, Twenty): free to run yourself, with limits mainly on reselling them as a hosted service.</li>
		<li><strong>Plex vs Jellyfin:</strong> Plex still has the slicker apps; Jellyfin is free, open, and loved. I lead with Jellyfin — and I'll tell you honestly when Plex fits better.</li>
		<li><strong>Email stays rented:</strong> running your own email server is the one job even most experts leave alone. I'll never sell it to you as an easy win.</li>
		<li><strong>I don't sell gear:</strong> no inventory, no hardware sales, no warranties on equipment. Demo machines show what's possible — everything else is your device, your hands, my guidance.</li>
	</ul>
</Layout>

<style>
	.tools {
		list-style: none;
		padding: 0;
	}
	.tools li {
		padding: 0.75rem 1rem;
		margin-bottom: 0.75rem;
		border-left: 4px solid var(--accent);
		border-radius: 0 8px 8px 0;
		background: rgba(var(--gray), 0.08);
	}
	.tools .replaces {
		display: block;
		font-size: 0.8em;
		font-style: italic;
		color: rgb(var(--gray));
	}
	.tools p {
		margin: 0.35rem 0 0;
		font-size: 0.9em;
	}
	h3 {
		margin-top: 2rem;
	}
</style>