---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Disintermediation.</h1>
			<p>
				Removing the parasitic middlemen from digital and physical infrastructure to empower community sovereignty.
			</p>
			<p>
				Punk Positronics is a movement toward a non-corporate, planet-first approach to technology. We believe in a "built-not-bought" world where you own your data, your hardware, and your destiny.
			</p>

			<div class="wings">
				<div class="wing">
					<h2>Digital Sovereignty</h2>
					<p>Cloud Exit Audits and Homestead Implementation. Break free from the cloud giants.</p>
					<a href="/digital" class="button">Enter the Digital Wing</a>
				</div>
				<div class="wing">
					<h2>Physical Sovereignty</h2>
					<p>Indie-Author Launchpad. Sustainable fulfillment that puts the creator first.</p>
					<a href="/physical" class="button">Enter the Physical Wing</a>
				</div>
				<div class="wing">
					<h2>Knowledge Distribution</h2>
					<p>Masterclasses and Build-Days. Learning the art of the sovereign stack.</p>
					<a href="/education" class="button">Enter the Learning Wing</a>
				</div>
			</div>

			<hr />
			<p style="text-align: center;">
				Want to see how the gears turn? <a href="/manual">Read the Open Ops Manual</a>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.wings {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		margin: 3rem 0;
	}
	.wing {
		padding: 1.5rem;
		border: 2px solid rgb(var(--gray));
		border-radius: 12px;
		transition: 0.2s ease;
	}
	.wing:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.wing h2 {
		margin-top: 0;
		font-size: 1.5rem;
		color: var(--accent);
	}
	.button {
		display: inline-block;
		margin-top: 1rem;
		padding: 0.5rem 1rem;
		background-color: var(--accent);
		color: white !important;
		text-decoration: none;
		border-radius: 4px;
		font-weight: bold;
	}
	.button:hover {
		filter: brightness(1.2);
	}
</style>
