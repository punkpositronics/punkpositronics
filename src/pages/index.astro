---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const ethos = [
	'Free & open-source',
	'Fix it, don\'t bin it',
	'Solar-punk spirit',
	'DIY & hands-on',
	'Community first',
	'Reused, not new',
	'Honest about energy',
];

const doors = [
	{
		title: 'I need tech help',
		text: 'Slow laptop? Messy passwords? Scam emails? Printer mysteries? Friendly, flat-fee help at the library table — and the first password lesson is free.',
		href: '/#quick-wins',
		cta: 'See the quick fixes',
	},
	{
		title: 'I run a business',
		text: 'Know your numbers without the software bill, get out from under subscription creep, and have someone who keeps it all running.',
		href: '/digital',
		cta: 'For business owners',
	},
];

const wings = [
	{
		title: 'Tech for small business',
		aside: 'the Digital Sovereignty wing',
		lines: [
			'Reports without the software bill — clear dashboards and automatic weekly reports built on free tools that do what Power BI or Tableau do. The flagship service.',
			'A way out of the cloud — a fixed-price audit of everything you subscribe to, with a step-by-step plan to replace it.',
			'Your own mini-cloud — your files, calendars, and passwords on a small refurbished server, set up with you and documented for you.',
			'Ongoing care — a monthly plan that keeps it all updated, backed up, and written down, so the knowledge never lives in one person\'s head. (The Guardian Retainer.)',
		],
		href: '/digital',
		cta: 'See what\'s possible',
	},
	{
		title: 'Guides & learning',
		aside: 'the Knowledge Base',
		lines: [
			'The Open Ops Manual — how this whole business runs, written down so anyone could read or copy it.',
			'The Free-Tools Catalog — a menu of free software that replaces paid subscriptions, sorted from easy to advanced.',
			'Classes & workshops — planned, and they start the moment enough people ask. Join the list on Punk Pages.',
		],
		href: '/education',
		cta: 'Learn more',
	},
];

const receipts = [
	{ stat: '1,300+', label: 'staff-hours a year saved by a single automation I built' },
	{ stat: '10+', label: 'regional business reports automated end-to-end' },
	{ stat: 'Global', label: 'a first-of-its-kind shipping report, adopted worldwide' },
	{ stat: '15 yrs', label: 'of data & logistics work behind every job I take' },
];

const journey = [
	{
		title: '1. Start anywhere',
		text: 'Read Punk Pages (the build-in-public blog) or meet me at the library table in Red Hill. No pitch, just a conversation.',
	},
	{
		title: '2. Fix one small thing',
		text: 'Passwords, a slow laptop, family photos, a kid\'s tablet. Small wins build confidence — and they\'re cheap, flat-fee, or free.',
	},
	{
		title: '3. Map what you rent',
		text: 'For businesses: a fixed-price audit lists every subscription you pay for, what it costs you, and what could replace it.',
	},
	{
		title: '4. Own your setup',
		text: 'Free tools on hardware that\'s yours, set up with you, with ongoing care if you want it. That\'s the whole destination.',
	},
];

const quickWins = [
	{
		title: 'The Password Consultation',
		text: 'FREE — 30 minutes, hands-on, using my demo phone (never your real accounts). Leave knowing exactly how to take your passwords back — and if you like, I\'ll set up a real password vault on hardware you own.',
	},
	{
		title: 'The Tech Clinic',
		text: 'One problem, one device, 45 minutes, $60 flat — pay what you can for seniors & students. Slow laptops, scam emails, printer mysteries, phone storage.',
	},
	{
		title: 'The Linux Revival',
		text: 'Your laptop isn\'t slow — Windows is. A guided install of free software on your own machine. No license fees, no spying, no forced updates.',
	},
	{
		title: 'Essay Rescue',
		text: 'For students: citations, Word files, and lost notes — sorted with free tools on your own computer. No subscription between you and your degree.',
	},
	{
		title: 'The Family Media Server',
		text: 'The flagship: that old laptop in the closet becomes your family\'s own Netflix. Your movies, photos, music & e-books — streaming at home, owned by you.',
	},
	{
		title: 'Kids\' Devices & Phone Revival',
		text: 'Lock down a child\'s device, or turn a retired phone into a safe, secure family tablet.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Tech you actually own.</h1>
				<p class="mission">
					Hi, I'm JT — your tech neighbor, not a corporation. I help neighbors and small businesses stop renting the tools they use every day — and own them instead.
				</p>
				<p>
					That means free, open-source software instead of endless subscriptions. Hardware given a second life instead of the landfill. And help that teaches you as it fixes, so you keep the files, the passwords, and the know-how.
				</p>
				<p>
					It's just me here — the person you talk to is the person who does the work, and everything gets written down so the knowledge stays with you.
				</p>
				<ul class="ethos">
					{ethos.map((tag) => <li>{tag}</li>)}
				</ul>
			</section>

			<div class="doors">
				{doors.map((d) => (
					<div class="door">
						<h3>{d.title}</h3>
						<p>{d.text}</p>
						<a href={d.href} class="button">{d.cta}</a>
					</div>
				))}
			</div>

			<section id="quick-wins">
				<h2 class="section-title">Quick fixes, flat prices</h2>
				<p>
					Now booking at <strong>Red Hill Library</strong> (weekends, by appointment — two slots a month, so booking ahead matters). Not sure where you fit? Send a message — if it turns out to be a bigger job, we'll talk it through before you pay anything.
				</p>
				<div class="wins">
					{quickWins.map((win) => (
						<div class="win">
							<h3>{win.title}</h3>
							<p>{win.text}</p>
						</div>
					))}
				</div>
			</section>

			<section>
				<h2 class="section-title">Two ways to work together</h2>
				<p>
					One person, two kinds of work. They keep each other honest — and everything gets written down in public.
				</p>
				<div class="wings">
					{wings.map((wing) => (
						<div class="wing">
							<h3>{wing.title} <span class="aside">{wing.aside}</span></h3>
							{wing.lines.map((line) => <p>{line}</p>)}
							<a href={wing.href} class="button">{wing.cta}</a>
						</div>
					))}
				</div>
			</section>

			<section>
				<h2 class="section-title">Receipts, not promises</h2>
				<p>Why trust the new guy? Because the work isn't new. Fifteen years of corporate data, automation, and logistics — with numbers to show for it:</p>
				<div class="receipts">
					{receipts.map((r) => (
						<div class="receipt">
							<div class="stat">{r.stat}</div>
							<p>{r.label}</p>
						</div>
					))}
				</div>
			</section>

			<section>
				<h2 class="section-title">The usual road in</h2>
				<p>Most people don't go all-in on day one, and you shouldn't either. Here's how it typically goes:</p>
				<ol class="journey">
					{journey.map((step) => (
						<li>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</li>
					))}
				</ol>
			</section>

			<section>
				<h2 class="section-title">A few promises</h2>
				<blockquote>
					<strong>I teach — I don't sell gear.</strong> No inventory, no hardware sales, no markups, no warranties on equipment. Your device, your hands, my guidance. What I sell is knowledge and labor, never markup.
				</blockquote>
				<blockquote>
					<strong>The greenest computer already exists.</strong> Everything here runs on refurbished hardware, with an honest, documented journey toward renewable energy.
				</blockquote>
				<blockquote>
					<strong>Nothing is hidden.</strong> The whole business is documented in public — read the <a href="/manual">Open Ops Manual</a> and judge for yourself.
				</blockquote>
			</section>

			<hr />
			<p style="text-align: center;">
				Book a slot or just ask a question: message <a href="https://www.instagram.com/punkpositronics" target="_blank" rel="noopener noreferrer">@punkpositronics</a> or email <a href="mailto:jt@punkpositronics.com">jt@punkpositronics.com</a>. Writing-in-public (and class announcements) happen on <a href="https://punkpositronics.substack.com/" target="_blank" rel="noopener noreferrer">Punk Pages</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 2rem;
	}
	.mission {
		font-size: 1.333em;
		font-weight: 700;
	}
	.ethos {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
	}
	.ethos li {
		padding: 0.25rem 0.75rem;
		border: 2px solid var(--accent);
		border-radius: 999px;
		font-size: 0.8em;
		font-weight: 700;
		color: var(--accent);
	}
	.doors {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		margin: 0 0 3rem;
	}
	.door {
		padding: 1.5rem;
		border: 3px solid var(--accent);
		border-radius: 12px;
	}
	.door h3 {
		margin-top: 0;
		font-size: 1.5rem;
		color: var(--accent);
	}
	.door p {
		font-size: 0.9em;
	}
	.section-title {
		font-size: 1.953em;
		color: var(--accent);
	}
	.aside {
		display: block;
		font-size: 0.55em;
		font-style: italic;
		font-weight: 600;
		color: rgb(var(--gray));
	}
	.wings {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		margin: 2rem 0;
	}
	.wing {
		padding: 1.5rem;
		border: 2px solid rgb(var(--gray));
		border-radius: 12px;
		transition: 0.2s ease;
	}
	.wing:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.wing h3 {
		margin-top: 0;
		font-size: 1.5rem;
		color: var(--accent);
	}
	.wing p {
		font-size: 0.85em;
	}
	.button {
		display: inline-block;
		margin-top: 0.5rem;
		padding: 0.5rem 1rem;
		background-color: var(--accent);
		color: white !important;
		text-decoration: none;
		border-radius: 4px;
		font-weight: bold;
	}
	.button:hover {
		filter: brightness(1.2);
	}
	.receipts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.5rem;
		margin: 2rem 0;
	}
	.receipt {
		padding: 1.5rem;
		text-align: center;
		border: 2px solid var(--accent);
		border-radius: 12px;
	}
	.receipt .stat {
		font-size: 2.2em;
		font-weight: 800;
		color: var(--accent);
		line-height: 1.1;
	}
	.receipt p {
		font-size: 0.8em;
		margin: 0.5rem 0 0;
	}
	.journey {
		list-style: none;
		padding: 0;
		margin: 2rem 0;
	}
	.journey li {
		padding: 0 0 0 1.25rem;
		border-left: 4px solid var(--accent);
		margin-bottom: 1.5rem;
	}
	.journey h3 {
		font-size: 1.25em;
		margin-bottom: 0.25rem;
	}
	.journey p {
		margin-bottom: 0;
	}
	.wins {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		margin: 2rem 0;
	}
	.win {
		padding: 1.5rem;
		border: 2px dashed rgb(var(--gray));
		border-radius: 12px;
	}
	.win h3 {
		margin-top: 0;
		font-size: 1.25em;
	}
	.win p {
		font-size: 0.85em;
		margin-bottom: 0;
	}
</style>
